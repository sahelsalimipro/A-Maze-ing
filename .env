# ┌───────────────────────────────────────┐
# │           AMAZEING CONFIG             │
# └───────────────────────────────────────┘

# Welcome to the settings! I really hope I gave you everything needed to
# make the pac-man of your dreams :)
# You may want to read everything in this file though, some things may not
# feel intuitive without it... oops hehe...
# Let me know if you have questions! login : <banordma>

# ====== General ======

MAZE_WIDTH=20 # int
# *** Number of tiles composing the maze horizontally ***

MAZE_HEIGHT=15 # int
# *** Number of tiles composing the maze vertically ***

SOLVED=FALSE # bool
# *** Is the maze solved by default ***

SEED=42 # int
# *** Seed from which the maze is generated ***

PERFECT=TRUE # bool
# *** True for a perfect maze, False for an imperfect one ***

# ====== Graphics ======

TILE_RATIO=3,1 # tuple[int, int]
# *** Describes the number of characters drawn horizontally vs vertically
# Most terminals display characters in ratio 1:2, therefore 2,1 should
# compensate on most configs. Change if it doesn't look good on yours.
# Edit: found out it looks better with 4,1 for me, so I'll let that
# as default
# Edit number 2: Holy shit rendering in Ascii is limited, to avoid
# a maximum using sextants (the square ugly tile-content chars),
# I'll go with 3,1 since it's an odd/odd combination and this will
# print a nicer circle character. Consider doing too... ***

CENTER_MAZE=TRUE # bool
# *** Center or not the Maze horizontally, calculated from the width of
# the displaying terminal at time of drawing ***

DISPLAY_BANNER=TRUE # bool
# *** Display or not the banner ***
# This is ignored when a theme is used ***

TOP_PADDING=2 # int
# *** Number of lines of padding inserted at the top of the banner/maze
# This is ignored when a theme is used ***

BOT_PADDING=2 # int
# *** Number of lines of padding inserted at the bottom of the maze
# This is ignored when a theme is used ***

LEFT_PADDING=4 # int
# *** Number of columns of padding inserted at the left of the maze
# This is ignored when CENTER_MAZE is set to TRUE
# This is ignored when a theme is used ***

RIGHT_PADDING=4 # int
# *** Number of columns of padding inserted at the right of the maze
# This is ignored when CENTER_MAZE is set to TRUE
# This is ignored when a theme is used ***

EXPAND_COLOR_TO_FULL_TERMINAL=TRUE # bool
# *** Colors the bacgkround of the whole terminal when there is still
# unpainted space on the right side of the elements.
# This is ignored when a theme is used ***

ENTRYPOINT_CHAR="◇" # str - len 1
# *** Char representing the entry of the maze.
# This is ignored when a theme is used ***

EXITPOINT_CHAR="✕" # str - len 1
# *** Char representing the exit of the maze.
# This is ignored when a theme is used ***

# ===== Graphics: Colors =====

# WARNING: Most color settings will be overriden if you use a theme
# Theme: THEME_ON=TRUE

BACKGROUND_CLR=10, 10, 10 # tuple[int, int, int] | None
# *** Changes the background color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (12,30,7)
# This is ignored when a theme is used ***

WALLS_CLR=252, 107, 3 # tuple[int, int, int] | None
# *** Changes the walls' color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (234,245,240)
# This is ignored when a theme is used ***

TRAIL_CLR=252, 182, 3 # tuple[int, int, int] | None
# *** Changes the trail's color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (234,245,240)
# This is ignored when a theme is used ***

LOGO_CLR=252, 182, 3 # tuple[int, int, int] | None
# *** Changes the logo's color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (234,245,240)
# This is ignored when a theme is used ***

ENTRYPOINT_CLR=NONE # tuple[int, int, int] | None
# *** Changes the entry point's color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (234,245,240)
# This is ignored when a theme is used ***

EXITPOINT_CLR=NONE # tuple[int, int, int] | None
# *** Changes the exit point's color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (234,245,240)
# This is ignored when a theme is used ***

TOP_PADDING_CLR=10, 10, 10 # tuple[int, int, int] | None
# *** Changes the top padding's background color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (12,30,7)
# This is ignored when a theme is used ***

BOT_PADDING_CLR=10, 10, 10 # tuple[int, int, int] | None
# *** Changes the bottom padding's background color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (12,30,7)
# This is ignored when a theme is used ***

LEFT_PADDING_CLR=10, 10, 10 # tuple[int, int, int] | None
# *** Changes the left padding's background color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (12,30,7)
# This is ignored when a theme is used ***

RIGHT_PADDING_CLR=10, 10, 10 # tuple[int, int, int] | None
# *** Changes the right padding's background color. None to keep the default color of
# the terminal. Else, provide an rgb color in range 0-256
# e.g : (12,30,7)
# This is ignored when a theme is used ***

BANNER_TITLE_CLR=252, 182, 3 # tuple[int, int, int] | None
# *** Changes the banner's title's foreground color. None to keep the default
# color of the terminal. Else, provide an rgb color in range 0-256
# e.g : (200,200,200)
# This is ignored when a theme is used ***

BANNER_FRAME_CLR=252, 107, 3  # tuple[int, int, int] | None
# *** Changes the banner's frame's foreground color. None to keep the default
# color of the terminal. Else, provide an rgb color in range 0-256
# e.g : (200,200,200)
# This is ignored when a theme is used ***

BANNER_BCKG_CLR=10, 10, 10 # tuple[int, int, int] | None
# *** Changes the banner's background color. None to keep the default
# color of the terminal. Else, provide an rgb color in range 0-256
# e.g : (200,200,200)
# This is ignored when a theme is used ***


# ===== BANNER =====

# WARNING: The banner display must be enabled
# Graphics: BANNER_DISPLAY=TRUE

BANNER_TITLE="AMAZEING" # str
# *** Enter the title of the banner you want displayed here. ***
# This is ignored when a theme is used ***

BANNER_TOP_CHAR="─" # str
# *** Enter the character used to draw the top of the banner here.
# If multiple chars provided, will repeat the sequence ***

BANNER_BOT_CHAR="─" # str
# *** Enter the character used to draw the bottom of the banner here.
# If multiple chars provided, will repeat the sequence ***

BANNER_LEFT_CHAR="│" # str
# *** Enter the character used to draw the left of the banner here.
# If multiple chars provided, will repeat the sequence ***

BANNER_RIGHT_CHAR="│" # str
# *** Enter the character used to draw the right of the banner here.
# If multiple chars provided, will repeat the sequence ***

BANNER_CORNER_TOPLEFT_CHAR="┌" # str - len 1
# *** Enter the character used to draw the top left of the banner here. ***

BANNER_CORNER_TOPRIGHT_CHAR="┐" # str - len 1
# *** Enter the character used to draw the top right of the banner here. ***

BANNER_CORNER_BOTLEFT_CHAR="└" # str - len 1
# *** Enter the character used to draw the bottom left of the banner here. ***

BANNER_CORNER_BOTRIGHT_CHAR="┘" # str - len 1
# *** Enter the character used to draw the bottom right of the banner here. ***

# See more settings related in:
# Graphics: Colors


# ===== Theme =====

THEME_ON=FALSE # bool
# *** Uses the defined theme or not.
# Note: Themes override numerous basic graphic settings ***

THEME_NAME="default" # str
# *** Choose the theme you want by default here.
# Accepted values are:
# - default (same as THEME_ON=FALSE)
# - matrix
# - nyan-cat
# - pac-man
# - peach-castle
# ***
